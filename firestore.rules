rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'isAdmin'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.isAdmin is bool
        && request.resource.data.isAdmin == (
          request.auth.token.email == 'daniel.r.gumbs@gmail.com'
          && request.auth.token.email_verified == true
        );
      // Role changes are made through the trusted Firebase console/Admin SDK.
      allow update, delete: if false;
    }
    function teamOf(data) {
      // Existing Firebase records are the original Vedette team.
      return data.get('teamId', 'vedette');
    }
    function validTeam(teamId) {
      return teamId is string && (teamId in ['vedette', '3e50d9da-5e7a-4c3b-ab1a-ec0276b4aa26']
        || exists(/databases/$(database)/documents/teams/$(teamId)));
    }
    function validLogo(logo) {
      return logo == null || (logo is string && logo.size() <= 180000
        && (logo == '/logo/vedette-logo.jpg'
          || logo.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/]+={0,2}$')));
    }
    match /teams/{id} {
      allow read: if request.auth != null;
      allow create, update: if admin()
        && request.resource.data.keys().hasAll(['name', 'logoUrl'])
        && request.resource.data.keys().hasOnly(['name', 'logoUrl'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && validLogo(request.resource.data.logoUrl);
      allow delete: if false;
    }
    function validSeason(data) {
      return data.seasonId is string && data.seasonId != 'previous-season'
        && validTeam(data.teamId)
        && exists(/databases/$(database)/documents/seasons/$(data.seasonId))
        && teamOf(get(/databases/$(database)/documents/seasons/$(data.seasonId)).data) == data.teamId;
    }
    function validSeasonData(data) {
      return data.keys().hasOnly(['name', 'teamId'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && validTeam(data.teamId);
    }
    function validCompetition(data, id) {
      return data.keys().hasOnly(['seasonId', 'type', 'teamId'])
        && validTeam(data.teamId) && data.type in ['competitie', 'beker']
        && id == data.seasonId + '_' + data.type
        && existsAfter(/databases/$(database)/documents/seasons/$(data.seasonId))
        && teamOf(getAfter(/databases/$(database)/documents/seasons/$(data.seasonId)).data) == data.teamId;
    }
    match /seasons/{id} {
      allow read: if request.auth != null;
      allow create: if admin() && validSeasonData(request.resource.data)
        && (id != 'previous-season' || request.resource.data.teamId == 'vedette');
      allow update: if admin() && validSeasonData(request.resource.data)
        && teamOf(resource.data) == request.resource.data.teamId;
    }
    match /competitions/{id} {
      allow read: if request.auth != null;
      allow create: if admin() && validCompetition(request.resource.data, id);
      allow update: if admin() && validCompetition(request.resource.data, id)
        && teamOf(resource.data) == request.resource.data.teamId
        && resource.data.seasonId == request.resource.data.seasonId;
    }
    match /players/{id} {
      allow read: if request.auth != null;
      allow create: if admin() && validSeason(request.resource.data)
        && request.resource.data.keys().hasOnly(['name', 'number', 'seasonId', 'competitionIds', 'teamId'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.number is int && request.resource.data.number >= 0
        && request.resource.data.competitionIds is list
        && request.resource.data.competitionIds.size() > 0
        && request.resource.data.competitionIds.hasOnly([request.resource.data.seasonId + '_competitie', request.resource.data.seasonId + '_beker']);
    }
    match /games/{id} {
      allow read: if request.auth != null;
      allow create: if admin() && validSeason(request.resource.data)
        && request.resource.data.league in ['competitie', 'beker']
        && request.resource.data.competitionId == request.resource.data.seasonId + '_' + request.resource.data.league
        && exists(/databases/$(database)/documents/competitions/$(request.resource.data.competitionId))
        && teamOf(get(/databases/$(database)/documents/competitions/$(request.resource.data.competitionId)).data)
          == request.resource.data.teamId
        && request.resource.data.opponent is string && request.resource.data.opponent.size() > 0
        && request.resource.data.date is string
        && request.resource.data.players is list && request.resource.data.events is list;
    }
  }
}
