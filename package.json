{
  "name": "voetbal-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run start:test",
    "start:test": "ng serve --configuration development",
    "start:e2e": "ng serve --configuration e2e --host 127.0.0.1 --port 4300",
    "test:e2e": "node scripts/run-e2e.cjs",
    "e2e:inside": "node --test tests/firestore.rules.test.cjs && playwright test",
    "test:e2e:report": "playwright show-report",
    "test:release": "node --test tests/release-safety.test.cjs",
    "hooks:install": "node scripts/install-hooks.cjs",
    "release:check": "npm run format:check && npm run test:release && npm run test:ci && npm run test:e2e && npm run build:prod && node scripts/verify-build-environment.cjs production",
    "start:production": "ng serve --configuration production --port 4201",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "firebase:login": "firebase login",
    "firebase:use": "firebase use",
    "deploy": "node scripts/deploy-production.cjs",
    "deploy:prod": "node scripts/deploy-production.cjs",
    "deploy:test": "ng build --configuration development --optimization --source-map=false && node scripts/verify-build-environment.cjs test && firebase deploy --project test --only hosting,firestore:rules",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ],
    "singleQuote": true,
    "semi": true,
    "tabWidth": 2,
    "printWidth": 100,
    "trailingComma": "all"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/forms": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@angular/router": "^21.2.18",
    "firebase": "^11.10.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.18",
    "@angular/cli": "^21.2.23",
    "@angular/compiler-cli": "^21.2.18",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.63.0",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.4.21",
    "firebase-tools": "^15.5.1",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3"
  }
}
