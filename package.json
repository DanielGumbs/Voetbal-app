{
  "name": "voetbal-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run start:test",
    "start:test": "ng serve --configuration development",
    "start:production": "ng serve --configuration production --port 4201",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "firebase:login": "firebase login",
    "firebase:use": "firebase use",
    "deploy": "npm run deploy:prod",
    "deploy:prod": "node scripts/verify-production-branch.cjs && npm run build:prod && node scripts/verify-build-environment.cjs production && firebase deploy --project production --only hosting,firestore:rules",
    "deploy:test": "ng build --configuration development --optimization --source-map=false && node scripts/verify-build-environment.cjs test && firebase deploy --project test --only hosting,firestore:rules",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ],
    "singleQuote": true,
    "semi": true,
    "tabWidth": 2,
    "printWidth": 100,
    "trailingComma": "all"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/forms": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@angular/router": "^21.2.18",
    "firebase": "^11.10.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.18",
    "@angular/cli": "^21.2.23",
    "@angular/compiler-cli": "^21.2.18",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.4.21",
    "firebase-tools": "^15.5.1",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3"
  }
}
